APP_SECRET_KEY=replace-me-in-production
JWT_SECRET=replace-me-in-production
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
AUTH_SERVER_URL=http://localhost:8001
AUTH_PUBLIC_URL=http://localhost:8001
AUTH_CLIENT_ID=business-attribution-web
AUTH_CLIENT_SECRET=local-demo-secret
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# MySQL 连接参数。复制本文件为 .env 后按本机环境修改。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_CHARSET=utf8mb4

APP_DB_NAME=business_attribution_app
AUTH_DB_NAME=business_attribution_auth
DEMO_DB_NAME=business_attribution_demo

# 也可以直接使用完整 SQLAlchemy URL，优先级高于上面的分项配置。
# APP_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/business_attribution_app?charset=utf8mb4
# AUTH_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/business_attribution_auth?charset=utf8mb4
# DEMO_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/business_attribution_demo?charset=utf8mb4
