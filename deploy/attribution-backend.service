[Unit]
Description=Business Attribution Backend
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=attribution
Group=attribution
WorkingDirectory=/opt/business-attribution
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/business-attribution/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
